generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Message {
  id        Int      @id @default(autoincrement())
  sender    String
  text      String
  createdAt DateTime @default(now())
}

model Task {
  id          Int     @id @default(autoincrement())
  title       String
  description String?
  authorId    Int
  author      User    @relation(fields: [authorId], references: [id])
  tags        Tag[]
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String
  tasks Task[]
}

model Tag {
  id    Int    @id @default(autoincrement())
  name  String @unique
  tasks Task[]
}
